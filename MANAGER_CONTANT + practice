class Contact:
        def __init__(self, name, phone, email):
            self.name = name
            self.phone = phone
            self.email = email
        def __str__(self):
            return f"{self.name} - {self.phone} - {self.email}"

import contact
import json
class ContactManager:
        def __init__(self, filename):
            self.filename = filename
            try:
                with open(self.filename, 'r') as file11:
                    jsonContent = json.load(file11)
                    self.contacts = jsonContent
            except (FileNotFoundError, json.JSONDecodeError):
                self.contacts = [ ]
            self.n = len(self.contacts) + 1
        def add_contact(self):
            choiceName = input("Welcome! What's Your Name?").lower().strip()
            choicePhone = input(f"Perfect, {choiceName} ! What's Your Phone Number?").lower().strip()
            choiceEmail = input("Finally, What's Your Email?").lower().strip()
            c = contact.Contact(choiceName, choicePhone, choiceEmail)
            dict1 = {"id": self.n, "name": c.name, "phone": c.phone, "email": c.email}
            self.contacts.append(dict1)
            with open("contacts.json", 'w') as file11:
                json.dump(self.contacts, file11)
            self.n = self.n + 1
        def show_all(self):
            with open("contacts.json", 'r') as file11:
                contacts = json.load(file11)
                print(contacts)
        def search(self):
            choiceMatch = input("What's Your Name?").strip().lower()
            found = False
            for c in self.contacts:
                if c["name"] == choiceMatch:
                    print(c)
                    found = True
            if not found:
                print('Not Found')
        def delete_contact(self):
            choiceDel = input("What Contact Do You Want To Delete?").strip().lower()
            self.contacts = [c for c in self.contacts if c["name"] != choiceDel]
            with open(self.filename, 'w') as file11:
                json.dump(self.contacts, file11)

import ContactManager
def main():
            while True:
                manager = ContactManager.ContactManager("contacts.json")
                choice1 = input('Welcome to Python Contact Manager! 1 - Add A Contact, 2 - Show All, 3 - Search, 4 - Delete, 5 - Quit').lower().strip()
                if choice1 == 'add a contact' or choice1 == '1':
                    manager.add_contact()
                elif choice1 == 'show all' or choice1 == '2':
                    manager.show_all()
                elif choice1 == 'search' or choice1 == '3':
                    manager.search()
                elif choice1 == 'delete' or choice1 == '4':
                    manager.delete_contact()
                elif choice1 == 'quit' or choice1 == '5':
                    print('Goodbye!')
                    break
					
if __name__ == "__main__":
    main()


